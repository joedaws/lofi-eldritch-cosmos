# /etc/lofi.env: settings and secrets for lofi.service
#   sudo cp infra/lofi.env.example /etc/lofi.env
#   sudo chown root:root /etc/lofi.env && sudo chmod 600 /etc/lofi.env
# systemd reads this file; values with spaces or <> must be quoted.

# generate with `mix phx.gen.secret` (or: head -c 48 /dev/urandom | base64)
SECRET_KEY_BASE=replace-me

# the public domain (decided later)
PHX_HOST=COSMOS_DOMAIN

PHX_SERVER=true
PORT=4100

# data lands in /var/lib/lofi-eldritch-cosmos (cosmos, accounts and history databases)
XDG_DATA_HOME=/var/lib

# start the simulation on boot
ELDRITCH_AUTOSTART=true

# login links are emailed through Resend (https://resend.com): an API key for a
# verified sending domain, and the address the emails come from
RESEND_API_KEY=replace-me
MAIL_FROM="Lofi Eldritch Cosmos <login@COSMOS_DOMAIN>"
